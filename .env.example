# ==============================================================================
# Sub2Pay / SimpleCard — Production Environment Configuration
# ==============================================================================

# Database:
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Production (Neon Serverless PostgreSQL / Managed Postgres):
# Run `pnpm db:postgres` before deploying to switch Prisma schema to PostgreSQL!
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Security & Secrets:
# Generate with: openssl rand -base64 32
JWT_SECRET="generate-a-strong-random-64-character-jwt-secret-in-production"

# Background Payment Reconciler Cron:
# Secure secret for pinging /api/cron/reconcile-payments
CRON_SECRET="generate-a-random-cron-secret-for-reconciler"

# Storefront Public URL:
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Transactional Email (For auto-sending credentials to customer & admin alerts):
# Option A: Standard SMTP
EMAIL_HOST="smtp.mailgun.org"
EMAIL_PORT="587"
EMAIL_USER="postmaster@yourdomain.com"
EMAIL_PASS="your-smtp-password"
DEFAULT_FROM_EMAIL="Sub2Pay Store <notifications@yourdomain.com>"
ADMIN_ALERT_EMAIL="owner@yourdomain.com"

# Option B: Resend API (Alternative to SMTP)
# RESEND_API_KEY="re_123456789"

# External Supplier API (Shop Bot protocol - tunvnmmo.duckdns.org):
SHOPBOT_BASE_URL="https://tunvnmmo.duckdns.org"
SHOPBOT_API_KEY="YOUR_SHOPBOT_API_KEY"

# Binance Spot Deposit Auto-Verification API:
# Requires Read-only Spot API Key + Secret from your Binance account
BINANCE_API_KEY="YOUR_BINANCE_API_KEY"
BINANCE_API_SECRET="YOUR_BINANCE_API_SECRET"
BINANCE_DEPOSIT_ADDRESS="YOUR_BINANCE_USDT_BEP20_ADDRESS"
BINANCE_DEPOSIT_NETWORK="BSC"

# Binance Pay Merchant API (Optional):
BINANCE_PAY_MERCHANT_ID=""
BINANCE_PAY_API_KEY=""
BINANCE_PAY_SECRET_KEY=""
